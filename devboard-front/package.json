    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.5.2",
    "@types/react": "19.1.2",
    "@types/react-dom": "19.1.2",
    "@vitejs/plugin-react": "4.4.1",
    "@vitest/coverage-v8": "3.1.1",
    "jsdom": "26.1.0",
    "msw": "2.7.0",
    "orval": "^8.6.2",
    "tailwindcss": "4.1.4",
    "typescript": "5.8.3",
    "vite": "6.3.2",
    "vitest": "3.1.1"
  }
}
